#!/bin/sh
# 커밋할 때 posts/index.json 을 자동으로 갱신해서 같은 커밋에 포함시킨다.
cd "$(git rev-parse --show-toplevel)" || exit 1
for py in venv/Scripts/python.exe venv/bin/python python3 python py; do
  if "$py" -c "" >/dev/null 2>&1; then
    "$py" tools/build_posts.py >/dev/null || exit 1
    git add posts/index.json
    exit 0
  fi
done
echo "pre-commit: Python을 찾지 못해 posts/index.json 갱신을 건너뜁니다 (GitHub Actions가 대신 갱신합니다)." >&2
exit 0
